// SPDX-License-Identifier: MIT

// Apple GPU Family 1-2 (visionOS simulator, older iOS devices) support max 512 threads
// per threadgroup. Use 256 on Metal to be safe. Mobile GPUs (Adreno/Mali) also get
// 256: the view-data kernels exceed the register budget at 1024 threads (fxc
// X4714), which costs occupancy. Desktop keeps 1024.
#if defined(SHADER_API_METAL) || defined(SHADER_API_MOBILE)
#define GROUP_SIZE 256
#else
#define GROUP_SIZE 1024
#endif

#pragma kernel CSSetIndices
#pragma kernel CSCalcDistances
#pragma kernel CSCalcViewData
#pragma kernel CSCalcViewDataStereo
#pragma kernel CSCopyViewDataAndDistances
#pragma kernel CSWriteIndirectArgs
#pragma kernel CSUpdateEditData
#pragma kernel CSInitEditData
#pragma kernel CSClearBuffer
#pragma kernel CSInvertSelection
#pragma kernel CSSelectAll
#pragma kernel CSOrBuffers
#pragma kernel CSSelectionUpdate
#pragma kernel CSTranslateSelection
#pragma kernel CSRotateSelection
#pragma kernel CSScaleSelection
#pragma kernel CSExportData
#pragma kernel CSCopySplats
#pragma kernel CSOcclusionClear
#pragma kernel CSOcclusionSplat
#pragma kernel CSOcclusionCull
#pragma kernel CSBakeQuads

// Sort kernels (InitDeviceRadixSort, Upsweep, Scan, Downsweep) moved to SplatSort.compute
// to keep wave-ops pragmas out of this file — required for visionOS Metal compatibility.
// NOTE: Do NOT add #pragma use_dxc here — it causes IsSupported()=false on visionOS Metal.

#include "../Shaders/GaussianSplatting.hlsl"
#include "../Shaders/GaussianVolume.hlsl"
#include "UnityCG.cginc"

float4x4 _MatrixObjectToWorld;
float4x4 _MatrixWorldToObject;
float4x4 _MatrixMV;
float4x4 _MatrixVP;
float4x4 _MatrixP;
uint _IsStereo;
uint _StereoEyeIndex;

// Single-dispatch stereo: both eyes' matrices passed at once
float4x4 _MatrixVP_Eye[2];
float4x4 _MatrixP_Eye[2];
float4x4 _MatrixMV_Eye[2];
float4 _VecScreenParams;
float4 _VecWorldSpaceCameraPos;

// ── Omni-directional stereo projection ────────────────────────────────────
// When enabled the whole sphere is projected into one 2:1 equirect image and
// _MatrixVP / _MatrixP are unused: ODS has no single view-projection matrix,
// because the eye position rotates with the view azimuth.
uint _OdsEnabled;
float4x4 _MatrixWorldToRig;
float4x4 _MatrixRigToWorld;
// x = signed eye offset (m), y = pole merge start (rad), z = pole merge end (rad)
float4 _OdsParams;
#define kOdsPi 3.14159265358979

int _SelectionMode;

RWStructuredBuffer<uint> _SplatSortDistances;
RWStructuredBuffer<uint> _SplatSortKeys;
RWStructuredBuffer<SplatViewData> _SplatViewData;
RWStructuredBuffer<uint> _VisibleCounter;   // [0] = visible splat count this sort
RWStructuredBuffer<uint> _IndirectArgs;     // 5 uints for DrawProceduralIndirect
uint _IndirectIndexCount;
uint _SplatCount;
uint _SrcSplatCount; // original source asset splat count (for morph OOB guard)

// Morph data (set by GaussianMorph, 4 float4s per splat)
// [0]: pos.xyz, opacity
// [1]: rot.xyzw
// [2]: scale.xyz, 0
// [3]: color.rgb, 1
StructuredBuffer<float4> _MorphedData;
uint _MorphDataValid; // 0 = no morph, 1 = morph (no SH), 2 = morph with blended SH
float _MorphWeight;   // morph blend weight (0 = source, 1 = target)

// Morph SH data: 15 float4 per splat, one band per element (xyz = coefficients).
// Unpacked on purpose — see _MorphSHOutput in GaussianMorph.compute.
StructuredBuffer<float4> _MorphSHData;

// Animation data (set by GaussianAnimator, 3 float4s per splat)
// [0]: posOffset.xyz (object space), opacityMul
// [1]: scaleMul, colorBlend, 0, 0
// [2]: colorTint.rgb, 1
// Sized for the source splat count: morph targets with extra splats have
// no animation entry, so every read is guarded by HasAnimData.
StructuredBuffer<float4> _AnimOutputData;
uint _AnimDataValid; // 0 = no animation, 1 = animation active

// Base pose from GaussianMeshDriver, 2 float4s per splat: center.xyz, 0;
// rotation.xyzw. Replaces the asset's position and rotation, under morph
// (which replaces everything) and animation (which offsets it).
StructuredBuffer<float4> _DeformedBase;
uint _DeformedBaseValid;

// Per-chunk bounds of moving splats (object space, 2 float4s per chunk:
// min, max), reduced each frame by the animation or mesh driver kernel so
// chunks stay cullable while they move.
StructuredBuffer<float4> _DynamicChunkBounds;
uint _DynamicChunkBoundsValid;

bool HasAnimData(uint idx)
{
    return _AnimDataValid != 0 && idx < _SrcSplatCount;
}

float3 LoadBasePos(uint idx)
{
    return _DeformedBaseValid != 0 ? _DeformedBase[idx * 2].xyz : LoadSplatPos(idx);
}

SplatData LoadBaseSplat(uint idx, uint shOrder)
{
    SplatData splat = LoadSplatData(idx, shOrder);
    if (_DeformedBaseValid != 0)
    {
        splat.pos = _DeformedBase[idx * 2].xyz;
        splat.rot = _DeformedBase[idx * 2 + 1];
    }
    return splat;
}

// Sort metric: 0 = view-space depth, 1 = radial distance from the camera.
// Radial order does not change when the camera only rotates, so a throttled
// or stale sort stays valid under head rotation (and ODS needs it anyway:
// view-space z is meaningless over a full sphere).
uint _SortRadial;

// Object-space position the sort keys are computed from: morphed if a morph
// is active, else the (mesh driven) base, plus the animation offset, so
// sorting matches what is drawn.
float3 LoadSortPos(uint idx)
{
    float3 pos;
    if (_MorphDataValid != 0)
        pos = _MorphedData[idx * 4].xyz;
    else
        pos = LoadBasePos(idx);
    if (HasAnimData(idx))
        pos += _AnimOutputData[idx * 3].xyz;
    return pos;
}

// Takes the position in sort-view space (_MatrixMV with z flipped forward).
float SortDepth(float3 viewPos)
{
    return (_SortRadial != 0) ? length(viewPos) : viewPos.z;
}

// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

// The sort is ascending. Offscreen under-blending wants front-to-back, the
// direct over-blend back-to-front, which inverts the key.
uint _SortBackToFront;
// Throttled sorts keep every splat: their keys outlive the view they were
// sorted for, and a splat culled now may be on screen after a head turn.
uint _SortAllVisible;

// Sort key for a visible splat. Clamped below the 0xFFFFFFFF sentinel that
// parks invisible splats at the tail, so a garbage depth can never join them.
uint DepthToSortKey(float depth)
{
    uint key = FloatToSortableUint(depth);
    if (_SortBackToFront != 0)
        key = ~key;
    return min(key, 0xFFFFFFFEu);
}

// A splat the view-data pass culled (frustum, opacity, compensated alpha)
// has zero axes and/or w <= 0. Such splats get sentinel sort keys, sink to
// the tail of the ascending sort, and are excluded from the indirect draw.
bool IsSplatViewVisible(SplatViewData view)
{
    return view.pos.w > 0 &&
        (view.axis1.x != 0 || view.axis1.y != 0 || view.axis2.x != 0 || view.axis2.y != 0);
}

[numthreads(GROUP_SIZE,1,1)]
void CSSetIndices (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    _SplatSortKeys[idx] = idx;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcDistances (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint origIdx = _SplatSortKeys[idx];

    bool visible = _SortAllVisible != 0;
    if (!visible)
    {
        if (_IsStereo != 0)
            visible = IsSplatViewVisible(_SplatViewData[origIdx * 2]) ||
                      IsSplatViewVisible(_SplatViewData[origIdx * 2 + 1]);
        else
            visible = IsSplatViewVisible(_SplatViewData[origIdx]);
    }
    if (!visible)
    {
        _SplatSortDistances[idx] = 0xFFFFFFFF;
        return;
    }

    float3 pos = mul(_MatrixMV, float4(LoadSortPos(origIdx), 1)).xyz;
    _SplatSortDistances[idx] = DepthToSortKey(SortDepth(pos));
    InterlockedAdd(_VisibleCounter[0], 1);
}

RWStructuredBuffer<SplatViewData> _CopyDstViewData;
RWStructuredBuffer<uint> _CopyDstSortDistances;
RWStructuredBuffer<uint> _CopyDstSortKeys;
uint _CopySrcStartIndex, _CopyDstStartIndex, _CopyKernelCount;
uint _CopyWriteKeys;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;
uint _BackfaceCull;
// sin of the fade angle before edge-on; 0 cuts back-facing splats off hard
float _BackfaceFadeWidth;

uint _SplatCutoutsCount;

#define SPLAT_CUTOUT_TYPE_SPHERE 0
#define SPLAT_CUTOUT_TYPE_BOX 1

struct GaussianCutoutShaderData // match GaussianCutout.ShaderData in C#
{
    float4x4 mat;
    uint typeAndFlags;
};
StructuredBuffer<GaussianCutoutShaderData> _SplatCutouts;

RWByteAddressBuffer _SplatSelectedBits;
ByteAddressBuffer _SplatDeletedBits;
uint _SplatBitsValid;

void DecomposeCovariance(float3 cov2d, out float2 v1, out float2 v2)
{
    #if 0 // does not quite give the correct results?

    // https://jsfiddle.net/mattrossman/ehxmtgw6/
    // References:
    // - https://www.youtube.com/watch?v=e50Bj7jn9IQ
    // - https://en.wikipedia.org/wiki/Eigenvalue_algorithm#2%C3%972_matrices
    // - https://people.math.harvard.edu/~knill/teaching/math21b2004/exhibits/2dmatrices/index.html
    float a = cov2d.x;
    float b = cov2d.y;
    float d = cov2d.z;
    float det = a * d - b * b; // matrix is symmetric, so "c" is same as "b"
    float trace = a + d;

    float mean = 0.5 * trace;
    float dist = sqrt(mean * mean - det);

    float lambda1 = mean + dist; // 1st eigenvalue
    float lambda2 = mean - dist; // 2nd eigenvalue

    if (b == 0) {
        // https://twitter.com/the_ross_man/status/1706342719776551360
        if (a > d) v1 = float2(1, 0);
        else v1 = float2(0, 1);
    } else
        v1 = normalize(float2(b, d - lambda2));

    v1.y = -v1.y;
    // The 2nd eigenvector is just a 90 degree rotation of the first since Gaussian axes are orthogonal
    v2 = float2(v1.y, -v1.x);

    // scaling components
    v1 *= sqrt(lambda1);
    v2 *= sqrt(lambda2);

    float radius = 1.5;
    v1 *= radius;
    v2 *= radius;

    #else

    // same as in antimatter15/splat
    float diag1 = cov2d.x, diag2 = cov2d.z, offDiag = cov2d.y;
    float mid = 0.5f * (diag1 + diag2);
    float radius = length(float2((diag1 - diag2) / 2.0, offDiag));
    float lambda1 = mid + radius;
    float lambda2 = max(mid - radius, 0.1);
    float2 diagVec = normalize(float2(offDiag, lambda1 - diag1));
    diagVec.y = -diagVec.y;
    float maxSize = 4096.0;
    v1 = min(sqrt(2.0 * lambda1), maxSize) * diagVec;
    v2 = min(sqrt(2.0 * lambda2), maxSize) * float2(diagVec.y, -diagVec.x);

    #endif
}

bool IsSplatCut(float3 pos)
{
    bool finalCut = false;
    for (uint i = 0; i < _SplatCutoutsCount; ++i)
    {
        GaussianCutoutShaderData cutData = _SplatCutouts[i];
        uint type = cutData.typeAndFlags & 0xFF;
        if (type == 0xFF) // invalid/null cutout, ignore
            continue;
        bool invert = (cutData.typeAndFlags & 0xFF00) != 0;

        float3 cutoutPos = mul(cutData.mat, float4(pos, 1)).xyz;
        if (type == SPLAT_CUTOUT_TYPE_SPHERE)
        {
            if (dot(cutoutPos, cutoutPos) <= 1) return invert;
        }
        if (type == SPLAT_CUTOUT_TYPE_BOX)
        {
            if (all(abs(cutoutPos) <= 1)) return invert;
        }
        finalCut = finalCut || !invert;
    }
    return finalCut;
}

// Opacity multiplier from backface culling. Splats sampled from a mesh
// surface carry the outward surface normal as their local +Z; ones facing
// away from the camera fade out over _BackfaceFadeWidth (in cosine) before
// edge-on. Both eyes test against the camera position, so a stereo pair
// never disagrees on which splats exist.
float BackfaceVisibility(float4 rot, float3 centerWorldPos)
{
    if (_BackfaceCull == 0)
        return 1.0;
    float3 objNormal = QuatRotateVector(float3(0, 0, 1), rot);
    // Normals transform by the inverse transpose, which also keeps them
    // right under the mirrored scale imported splats carry
    float3 worldNormal = normalize(mul(objNormal, (float3x3)_MatrixWorldToObject));
    float facing = dot(worldNormal, normalize(_VecWorldSpaceCameraPos.xyz - centerWorldPos));
    return _BackfaceFadeWidth > 0 ? saturate(facing / _BackfaceFadeWidth) : (facing > 0 ? 1.0 : 0.0);
}

// The renderer's styles (GaussianStyleSet), one slot each; every splat
// wears the slot StyleAt picks, blended in by its weight. The color side
// lives in GaussianStyle.hlsl; the shape, snap and blend here.
#include "../Shaders/GaussianStyle.hlsl"
// Per slot: x GaussianSplatStyleShape, y dot radius (pixels),
// z GaussianSplatStyleStreakAxis, w streak length (world units)
float4 _StyleShapeParams[MAX_STYLES];
// Per slot: xyz streak direction (world, normalized), w unused
float4 _StyleStreakParams[MAX_STYLES];
// Per slot: x streak half width (pixels), y dot diameter / streak width
// floor in world units (0 = off), z additivity at full weight (scaled per
// splat by its style weight), w fraction of splats kept
float4 _StyleSizeParams[MAX_STYLES];
// Per slot: x GaussianSplatStyleQuantize, y spacing (world units), z world
// units around a slice or grid point that stay, w slice offset
float4 _StyleQuantizeParams[MAX_STYLES];
// Per slot: xyz slice normal (world, normalized)
float4 _StyleSliceNormals[MAX_STYLES];
// World distance what the styles draw can lie from the splat (snap, streak
// and size floor), for frustum culling,
// and the same in object space for the chunk bounds
float _StyleReach;
float _StyleChunkExpand;
// Same values the splat shader shapes its quads with (GaussianSplatConfig)
float _SplatQuadExtent;
float _SplatMaxPixelRadius;
// Quads baked into the view data for RenderGaussianStylized.shader (see
// BakeQuad): every renderer in PointCloud mode, styled ones in Splats mode
uint _BakeQuads;
uint _QuadBaseShape;        // 0 = Gaussian (Splats), 1 = point (PointCloud)
// Non-zero: the view-data kernels leave the quads to CSBakeQuads, because a
// pass in between (occlusion culling) reads the Gaussian footprints
uint _QuadBakeDeferred;
float4x4 _MatrixInvVP;
float4x4 _MatrixInvVP_Eye[2];
// PointCloud point sizing (GaussianSplatConfig)
float _PointSizeScale;
float _PointMinSize;
float _PointMaxSize;
float _PointMinWorldSize;   // diameter in world units, 0 = off
// Pixels per unit of size over distance: cot(fovY/2), or 2/pi under ODS.
// Set whenever quads are baked (point cloud or style)
float _ProjectionScale;
// Pushes low-opacity points towards solid ones while still letting
// opacity-driven effects (dissolve, cutouts) fade them out
float _PointOpacityBoost;
// Depth of field (GaussianDepthOfField on the camera): x lens radius in world
// units (0 = off), y reciprocal focus distance, z largest blur radius in pixels
float4 _DofParams;
// Splats contributing less than this are culled (see SplatContribution;
// StyleBrightnessBound stands in for the colour, which is not known yet at
// every cull). Tested before depth of field blurs them: a blurred splat keeps
// its light, however faint it is spread.
#define SPLAT_CULL_ALPHA (5.0 / 255.0)

// Focal length in pixels: the screen distance a unit of size spans at unit
// distance
float DofFocalPx(float4x4 pMatrix)
{
    return _OdsEnabled != 0 ? _VecScreenParams.x / (2.0 * kOdsPi) : _VecScreenParams.y * abs(pMatrix._m11) * 0.5;
}

// Radius in pixels of the circle a point at this distance from the camera
// blurs into, through a thin lens focused at the focus distance
float DofBlurRadius(float dist, float focalPx)
{
    if (_DofParams.x <= 0 || dist <= 0)
        return 0;
    return min(_DofParams.x * abs(_DofParams.y - 1.0 / dist) * focalPx, _DofParams.z);
}

// Grows a Gaussian footprint by a blur circle and returns the factor its
// opacity drops by to keep the splat's light. The half-axes are sqrt(2)
// sigma; a disc of radius r spreads like a Gaussian of variance r^2/4, added
// along every direction, so the axes keep their directions.
float DofBlurAxes(inout float2 axis1, inout float2 axis2, float blurPx)
{
    if (blurPx <= 0)
        return 1;
    float add = 0.5 * blurPx * blurPx;
    float l1 = max(dot(axis1, axis1), 1e-8);
    float l2 = max(dot(axis2, axis2), 1e-8);
    float s1 = sqrt((l1 + add) / l1);
    float s2 = sqrt((l2 + add) / l2);
    axis1 *= s1;
    axis2 *= s2;
    return 1.0 / (s1 * s2);
}

// Same for a round footprint of the given radius in pixels: a disc blurred
// by a disc, kept a disc
float DofBlurRadiusPx(inout float radius, float blurPx)
{
    if (blurPx <= 0)
        return 1;
    float r2 = max(radius * radius, 1e-8);
    float blurred2 = r2 + blurPx * blurPx;
    radius = sqrt(blurred2);
    return r2 / blurred2;
}

// Half-width in pixels below which a baked quad is drawn wider instead. The
// fragment's antialiased edge is a pixel wide, so a thinner quad misses pixel
// centres and breaks into steps and dashes, which shimmer once the frame is
// resampled (equirect playback) and which 4:2:0 video smears the colour out of.
#define QUAD_MIN_HALF_WIDTH 1.0

// Widens a half-extent in pixels to the minimum and returns the factor its
// opacity drops by along that axis to keep its light
float QuadMinHalfWidth(inout float halfWidth)
{
    if (halfWidth >= QUAD_MIN_HALF_WIDTH)
        return 1;
    float fade = max(halfWidth, 0) / QUAD_MIN_HALF_WIDTH;
    halfWidth = QUAD_MIN_HALF_WIDTH;
    return fade;
}

// Pixels a world size spans at clip w (the camera distance)
float WorldSizeToPixels(float worldSize, float w)
{
    return worldSize * 0.5 * _ProjectionScale * _VecScreenParams.y / w;
}

// The fragment's antialiased rim covers the outermost pixel of a disc quad.
// Padding the quad by half a pixel centres the rim on the disc's edge, so a
// disc gives the light of its nominal area at any size; unpadded, a small
// disc loses most of its light to the rim while a blurred one loses little.
#define QUAD_DISC_EDGE_PAD 0.5

// Snaps a styled splat toward its slice or grid point and fades the splats
// the style drops (thinning, or too far from a slice or grid point) by
// scaling their opacity, so at full weight the opacity cull removes them from
// sorting and drawing. Runs before projection: the moved position feeds
// everything downstream, in both eyes alike.
void ApplyStyleQuantize(uint idx, StyleSample style, inout SplatData splat, inout float3 worldPos)
{
    if (style.weight <= 0)
        return;

    float keepFraction = _StyleSizeParams[style.slot].w;
    float4 q = _StyleQuantizeParams[style.slot];
    float3 sliceNormal = _StyleSliceNormals[style.slot].xyz;
    float keep = (keepFraction >= 1 || StyleHash01(idx ^ 0x2c1b3c6du) < keepFraction) ? 1.0 : 0.0;
    float3 snapped = worldPos;
    float dist = 0;
    if (q.x > 0.5 && q.x < 1.5)
    {
        float d = (dot(worldPos, sliceNormal) - q.w) / q.y;
        float offset = (round(d) - d) * q.y;
        snapped = worldPos + sliceNormal * offset;
        dist = abs(offset);
    }
    else if (q.x > 1.5)
    {
        snapped = round(worldPos / q.y) * q.y;
        float3 offset = abs(snapped - worldPos);
        dist = max(offset.x, max(offset.y, offset.z));
    }
    // A soft edge, so splats drifting across it (animation) fade rather than pop
    keep *= 1.0 - smoothstep(q.z * 0.7, q.z, dist);

    worldPos = lerp(worldPos, snapped, style.weight);
    splat.pos = mul(_MatrixWorldToObject, float4(worldPos, 1)).xyz;
    splat.opacity *= (half)lerp(1.0, keep, style.weight);
}

// Takes and returns gamma-space color, like the SH output it modifies
// View-independent intermediate data computed once for both eyes.
struct SplatSharedData
{
    float3 worldPos;
    float3 cov3d0;
    float3 cov3d1;
    half4 color;   // SH-evaluated color + opacity
    float maxScale; // largest world-space axis scale, for the frustum margin
    StyleSample style;
    bool skip;     // deleted, cut, or zero opacity
};

// Compute view-independent data: 3D covariance, SH, opacity. Called once per splat.
SplatSharedData CalcSharedSplatData(
    uint idx, SplatData splat, float3 centerWorldPos, bool isDeleted, bool isCut,
    float splatScale, half opacityScale,
    float animOpacityMul, float animScaleMul, float animColorBlend, float3 animColorTint,
    StyleSample style)
{
    SplatSharedData ssd = (SplatSharedData)0;
    ssd.worldPos = centerWorldPos;
    ssd.style = style;
    ssd.skip = isDeleted || isCut;

    float finalOpacity = splat.opacity * opacityScale * animOpacityMul
                       * BackfaceVisibility(splat.rot, centerWorldPos);
    if (finalOpacity * StyleBrightnessBound(style) < SPLAT_CULL_ALPHA) { ssd.skip = true; return ssd; }
    if (ssd.skip) return ssd;

    float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(splat.rot, splat.scale * animScaleMul);
    CalcCovariance3D(splatRotScaleMat, ssd.cov3d0, ssd.cov3d1);
    float splatScale2 = splatScale * splatScale;
    ssd.cov3d0 *= splatScale2;
    ssd.cov3d1 *= splatScale2;
    ssd.maxScale = max(max(abs(splat.scale.x), abs(splat.scale.y)), abs(splat.scale.z))
                 * splatScale * animScaleMul;

    float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
    float3 objViewDir = normalize(mul((float3x3)_MatrixWorldToObject, worldViewDir));

    ssd.color.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
    if (animColorBlend > 0)
        ssd.color.rgb = lerp(ssd.color.rgb, (half3)animColorTint, (half)animColorBlend);
    ssd.color.rgb = ApplyStyle(ssd.color.rgb, style, splat, centerWorldPos, idx);
    ssd.color.a = min(finalOpacity, 65000);

    return ssd;
}

// Per-eye lightweight projection: clip position, 2D covariance, axis decomposition.
SplatViewData CalcPerEyeViewData(
    SplatData splat, SplatSharedData ssd,
    float4x4 vpMatrix, float4x4 pMatrix, float4x4 mvMatrix,
    float splatScale)
{
    SplatViewData view = (SplatViewData)0;
    if (ssd.skip) return view;

    float4 clipPos = mul(vpMatrix, float4(ssd.worldPos, 1));

    // Conservative frustum cull
    if (clipPos.w > 0)
    {
        float clipMargin = (ssd.maxScale + _StyleReach) * abs(pMatrix._m00);
        float w = clipPos.w;
        if ((clipPos.x < -(w+clipMargin)) || (clipPos.x > (w+clipMargin)) ||
            (clipPos.y < -(w+clipMargin)) || (clipPos.y > (w+clipMargin)))
            clipPos.w = 0;
    }
    view.pos = clipPos;

    if (clipPos.w > 0)
    {
        float alphaScale;
        float3 cov2d = CalcCovariance2D(splat.pos, ssd.cov3d0, ssd.cov3d1,
                                         mvMatrix, pMatrix, _VecScreenParams, alphaScale);

        // Cull on compensated opacity instead of projected area: a splat only
        // gets culled once it has faded to invisible, so nothing pops at the
        // cull boundary. Axes stay zero -> degenerate quad, no fragments.
        half finalAlpha = ssd.color.a * (half)alphaScale;
        if (finalAlpha * StyleBrightnessBound(ssd.style) < SPLAT_CULL_ALPHA)
            return view;

        DecomposeCovariance(cov2d, view.axis1, view.axis2);

        // Baked quads take their blur in BakeQuad, with the shape they morph into
        if (_BakeQuads != 0)
        {
            view.color = PackBakedViewColor(ssd.color.rgb, finalAlpha, ssd.style.weight, ssd.style.slot);
        }
        else
        {
            finalAlpha *= (half)DofBlurAxes(view.axis1, view.axis2, DofBlurRadius(clipPos.w, DofFocalPx(pMatrix)));
            view.color = PackViewColor(half4(ssd.color.rgb, finalAlpha));
        }
    }
    return view;
}

// Solves the ODS tangency condition in closed form.
//
// In rig-local space (+x right, +y up, +z forward) the eye for azimuth t sits
// at E(t) = r*(cos t, 0, -sin t) and looks along d(t) = (sin t, 0, cos t).
// Requiring E->p to be parallel to d gives
//     p.x*cos t - p.z*sin t - r = 0   ->   rho*sin(phi - t) = r
// so t = phi - asin(r/rho): one asin per splat, no iteration, no stitching.
//
// Returns clip space with w carrying the eye-to-splat distance, so every
// downstream consumer that divides by w (quad sizing, the world-space size
// floor in the point shader) keeps working untouched.
float4 OdsProjectSplat(float3 worldPos, out float distOut)
{
    float3 p = mul(_MatrixWorldToRig, float4(worldPos, 1)).xyz;

    float rho = length(p.xz);
    float phi = atan2(p.x, p.z);

    // Pole merge: fade the circle radius to zero approaching the poles, where
    // a baseline perpendicular to the view direction cannot exist. Elevation
    // is measured from the rig centre to keep the solve non-circular — using
    // the final elevation would make the radius depend on its own result.
    float elev0 = atan2(p.y, max(rho, 1e-6));
    float merge = 1.0 - smoothstep(_OdsParams.y, _OdsParams.z, abs(elev0));
    float r = _OdsParams.x * merge;

    // No tangent line exists from inside the viewing circle; collapse to mono.
    float sinA = (rho > abs(r)) ? (r / rho) : 0.0;
    float theta = phi - asin(clamp(sinA, -1.0, 1.0));
    // The eye offset can carry a splat behind the rig past +-pi; wrap it to
    // the other side of the equirect instead of off the image
    if (theta < -kOdsPi)
        theta += 2.0 * kOdsPi;
    else if (theta > kOdsPi)
        theta -= 2.0 * kOdsPi;

    float3 eye = float3(r * cos(theta), 0.0, -r * sin(theta));
    float3 v = p - eye;

    float elev = atan2(v.y, max(length(v.xz), 1e-6));
    distOut = max(length(v), 1e-4);

    // Azimuth spans [-pi, pi] across the width, elevation [-pi/2, pi/2] across
    // the height. _OdsParams.w carries the render-target Y sign that a GPU
    // projection matrix would normally apply — there is no matrix here.
    // Depth is a constant mid-range value that passes a cleared depth buffer
    // under both normal and reversed Z; ODS has no meaningful z, and the point
    // cloud pass resolves occlusion through the sort order instead.
    float2 ndc = float2(theta / kOdsPi, elev / (0.5 * kOdsPi) * _OdsParams.w);
    return float4(ndc * distOut, 0.5 * distOut, distOut);
}

// Inverse of OdsProjectSplat, for passes that only have the view data. The
// eye circle radius is taken at the final elevation rather than the
// rig-centre one the projection uses; they differ by a sliver of the eye
// offset over the distance.
float3 OdsUnproject(float4 clip)
{
    float2 ndc = clip.xy / clip.w;
    float theta = ndc.x * kOdsPi;
    float elev = ndc.y * _OdsParams.w * (0.5 * kOdsPi);
    float merge = 1.0 - smoothstep(_OdsParams.y, _OdsParams.z, abs(elev));
    float r = _OdsParams.x * merge;
    float3 eye = float3(r * cos(theta), 0.0, -r * sin(theta));
    float3 v = clip.w * float3(cos(elev) * sin(theta), sin(elev), cos(elev) * cos(theta));
    return mul(_MatrixRigToWorld, float4(eye + v, 1)).xyz;
}

// Bakes a splat's draw quad into its view data for the quad shader
// (RenderGaussianStylized.shader): the axes become the quad's half-axes in
// pixels, drawn as they are, and pos moves to the quad's centre. The base is
// the render mode's own shape -- the Gaussian quad (extent and pixel cap
// included) in Splats mode, the point in PointCloud mode -- and the style
// weight (per splat, in the view color) morphs it into the style's shape.
// Depth of field blurs both shapes, each keeping its own light, and shapes
// thinner than QUAD_MIN_HALF_WIDTH are widened the same way.
void BakeQuad(inout SplatViewData view, float3 worldPos, float4x4 vpMatrix, float focalPx)
{
    bool visible = view.pos.w > 0 && any(view.axis1 != 0 || view.axis2 != 0);
    if (_BakeQuads == 0 || !visible)
        return;

    if (_QuadBaseShape == 1)
    {
        // Boost and clamp the point's opacity here, before the fades below:
        // a fade applied ahead of the clamp mostly vanishes into the boost's
        // headroom, so a blurred or widened point would gain light instead of
        // spreading it. The sign is the editor's selection flag.
        half a = ViewAlpha(view.color);
        half boosted = saturate(abs(a) * (half)_PointOpacityBoost);
        SetViewAlpha(view.color, a < 0 ? -boosted : boosted);
    }

    float styleWeight = BakedViewStyleWeight(view.color);
    uint slot = BakedViewStyleSlot(view.color);
    float blurPx = DofBlurRadius(view.pos.w, focalPx);
    float2 g1, g2;
    // Opacity factor the blur takes from the base shape
    float baseFade;
    if (_QuadBaseShape == 1)
    {
        // Follow the projected footprint (~1 sigma) so nearby points keep
        // covering the surface, clamped to keep the point look. The world
        // size floor stops points shrinking to dust up close, where grazing
        // splats collapse, and overrides the max clamp.
        float footprint = sqrt(length(view.axis1) * length(view.axis2));
        float sizePx = clamp(footprint * _PointSizeScale, _PointMinSize, _PointMaxSize);
        if (_PointMinWorldSize > 0)
            sizePx = max(sizePx, WorldSizeToPixels(_PointMinWorldSize, view.pos.w));
        float radius = sizePx * 0.5;
        baseFade = DofBlurRadiusPx(radius, blurPx);
        float widen = QuadMinHalfWidth(radius);
        baseFade *= widen * widen;
        radius += QUAD_DISC_EDGE_PAD;
        g1 = float2(radius, 0);
        g2 = float2(0, radius);
    }
    else
    {
        baseFade = DofBlurAxes(view.axis1, view.axis2, blurPx);
        g1 = view.axis1 * _SplatQuadExtent;
        g2 = view.axis2 * _SplatQuadExtent;
        float r1 = length(g1), r2 = length(g2);
        if (r1 > _SplatMaxPixelRadius) g1 *= _SplatMaxPixelRadius / r1;
        if (r2 > _SplatMaxPixelRadius) g2 *= _SplatMaxPixelRadius / r2;
    }
    view.axis1 = g1;
    view.axis2 = g2;
    if (styleWeight <= 0)
    {
        SetViewAlpha(view.color, ViewAlpha(view.color) * (half)baseFade);
        return;
    }

    float2 t1 = g1, t2 = g2;
    float shapeFade = baseFade;
    float2 centerNdc = view.pos.xy / view.pos.w;
    // The world size floor grows the fixed pixel size up close, so the
    // shapes keep their size against the scene instead of shrinking into it
    float4 shape = _StyleShapeParams[slot];
    float4 size = _StyleSizeParams[slot];
    float minHalfPx = size.y > 0 ? WorldSizeToPixels(size.y, view.pos.w) * 0.5 : 0;
    if (shape.x > 0.5 && shape.x < 1.5)
    {
        float radius = max(shape.y, minHalfPx);
        shapeFade = DofBlurRadiusPx(radius, blurPx);
        float widen = QuadMinHalfWidth(radius);
        shapeFade *= widen * widen;
        radius += QUAD_DISC_EDGE_PAD;
        t1 = float2(radius, 0);
        t2 = float2(0, radius);
    }
    else if (shape.x > 1.5)
    {
        float3 dir = shape.z < 0.5
            ? _StyleStreakParams[slot].xyz
            : normalize(worldPos - _VecWorldSpaceCameraPos.xyz);
        float3 tailWorld = worldPos + dir * shape.w;
        float2 headNdc = view.pos.xy / view.pos.w;
        float2 tailNdc;
        if (_OdsEnabled != 0)
        {
            float tailDist;
            float4 tailClip = OdsProjectSplat(tailWorld, tailDist);
            tailNdc = tailClip.xy / tailClip.w;
            // The equirect wraps at +-180 degrees: keep the tail on the
            // head's side, past the image edge, so a streak crossing the
            // seam is cut there instead of spanning the whole image
            if (tailNdc.x - headNdc.x > 1)
                tailNdc.x -= 2;
            else if (tailNdc.x - headNdc.x < -1)
                tailNdc.x += 2;
        }
        else
        {
            float4 tailClip = mul(vpMatrix, float4(tailWorld, 1));
            // A tail behind the eye would wrap around: cut the segment where
            // it nears the camera plane
            float wMin = view.pos.w * 0.05;
            if (tailClip.w < wMin)
                tailClip = lerp(view.pos, tailClip, (view.pos.w - wMin) / (view.pos.w - tailClip.w));
            tailNdc = tailClip.xy / tailClip.w;
        }
        // Half the segment, in pixels; the head sits at quad x = -1
        float2 halfSeg = (tailNdc - headNdc) * 0.25 * _VecScreenParams.xy;
        float len = length(halfSeg);
        float2 along = len > 1e-4 ? halfSeg / len : float2(1, 0);
        // Never shorter than wide: a streak seen end-on stays a dot
        float halfWidth = max(size.x, minHalfPx);
        float halfLength = max(len, halfWidth);
        // A line blurs across and along on its own: each keeps its light
        // over its own extent
        shapeFade = sqrt(DofBlurRadiusPx(halfLength, blurPx) * DofBlurRadiusPx(halfWidth, blurPx));
        shapeFade *= QuadMinHalfWidth(halfLength) * QuadMinHalfWidth(halfWidth);
        t1 = along * halfLength;
        t2 = float2(-along.y, along.x) * halfWidth;
        centerNdc = headNdc + t1 * 2.0 / _VecScreenParams.xy;
    }

    // The base's axes have arbitrary signs and order; match them to the
    // target's so the morph does not twist
    if (abs(dot(g1, t2)) + abs(dot(g2, t1)) > abs(dot(g1, t1)) + abs(dot(g2, t2)))
    {
        float2 tmp = g1; g1 = g2; g2 = tmp;
    }
    if (dot(g1, t1) < 0) g1 = -g1;
    if (dot(g2, t2) < 0) g2 = -g2;

    view.axis1 = lerp(g1, t1, styleWeight);
    view.axis2 = lerp(g2, t2, styleWeight);
    view.pos.xy = lerp(view.pos.xy, centerNdc * view.pos.w, styleWeight);
    SetViewAlpha(view.color, ViewAlpha(view.color) * (half)lerp(baseFade, shapeFade, styleWeight));
}

// Per-eye view data calculation helper (original single-eye path).
// Computes clip-space position, covariance, SH shading, and packs into SplatViewData.
// Shared data (world pos, splat loading, animation) is computed once in the kernel;
// this function handles the VP-dependent steps for each eye.
SplatViewData CalculateEyeViewData(
    uint idx,
    SplatData splat,
    float3 centerWorldPos,
    float4x4 viewProjMatrix,
    bool isDeleted,
    bool isCut,
    float splatScale,
    half opacityScale,
    float animOpacityMul,
    float animScaleMul,
    float animColorBlend,
    float3 animColorTint,
    StyleSample style)
{
    SplatViewData view = (SplatViewData)0;

    float odsDist = 0;
    float4 centerClipPos = (_OdsEnabled != 0)
        ? OdsProjectSplat(centerWorldPos, odsDist)
        : mul(viewProjMatrix, float4(centerWorldPos, 1));

    // Mark deleted or cut splats as invisible
    if (isDeleted || isCut)
        centerClipPos.w = 0;

    // Conservative frustum cull: max scale as bounding radius -> clip-space margin.
    // Skipped under ODS: the projection covers the whole sphere, so nothing is
    // ever off-screen and there is no _MatrixP to derive a clip margin from.
    if (_OdsEnabled == 0 && centerClipPos.w > 0)
    {
        float maxScale = max(max(abs(splat.scale.x), abs(splat.scale.y)), abs(splat.scale.z))
                       * splatScale * animScaleMul;
        float clipMargin = (maxScale + _StyleReach) * abs(_MatrixP._m00);
        float w = centerClipPos.w;
        bool outsideFrustum = (centerClipPos.x < -(w + clipMargin)) ||
                              (centerClipPos.x >  (w + clipMargin)) ||
                              (centerClipPos.y < -(w + clipMargin)) ||
                              (centerClipPos.y >  (w + clipMargin));
        if (outsideFrustum)
            centerClipPos.w = 0;
    }

    view.pos = centerClipPos;

    // Early opacity culling: skip splats with negligible opacity
    float finalOpacity = splat.opacity * opacityScale * animOpacityMul
                       * BackfaceVisibility(splat.rot, centerWorldPos);
    if (finalOpacity * StyleBrightnessBound(style) < SPLAT_CULL_ALPHA)
        return view;

    bool behindCam = centerClipPos.w <= 0;
    if (!behindCam)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale * animScaleMul;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float alphaScale = 1.0;
        float3 cov2d = 0;
        if (_OdsEnabled == 0)
            cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, _MatrixP, _VecScreenParams, alphaScale);

        // Cull on compensated opacity instead of projected area: a splat only
        // gets culled once it has faded to invisible, so nothing pops at the
        // cull boundary. Axes stay zero -> degenerate quad, no fragments.
        float finalAlpha = min(finalOpacity, 65000) * alphaScale;
        if (finalAlpha * StyleBrightnessBound(style) < SPLAT_CULL_ALPHA)
            return view;

        if (_OdsEnabled != 0)
        {
            // ODS has no projection matrix, so a screen-space covariance is not
            // defined. PointCloud mode only consumes sqrt(|axis1|*|axis2|) as a
            // size, so synthesise an isotropic footprint from the angular
            // radius: a world radius R at distance D subtends R/D radians, and
            // the equirect maps 2*pi radians of azimuth across the full width.
            // Bounded: a splat sitting almost on the eye divides by a near-zero
            // distance and would otherwise emit a quad millions of pixels wide,
            // which stalls the rasteriser hard enough to lose the device. The
            // cap sits far above any usable point size.
            float worldRadius = max(max(abs(boxSize.x), abs(boxSize.y)), abs(boxSize.z)) * splatScale;
            float footprintPx = min((worldRadius / odsDist) * (_VecScreenParams.x / (2.0 * kOdsPi)),
                                    _VecScreenParams.x * 0.125);
            view.axis1 = float2(footprintPx, 0);
            view.axis2 = float2(0, footprintPx);
        }
        else
        {
            DecomposeCovariance(cov2d, view.axis1, view.axis2);
        }

        float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
        float3 objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
        objViewDir = normalize(objViewDir);

        half4 col;
        col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);

        // Apply animation color tint
        if (animColorBlend > 0)
            col.rgb = lerp(col.rgb, (half3)animColorTint, (half)animColorBlend);
        col.rgb = ApplyStyle(col.rgb, style, splat, centerWorldPos, idx);

        // Baked quads take their blur in BakeQuad, with the shape they morph into
        if (_BakeQuads != 0)
        {
            view.color = PackBakedViewColor(col.rgb, (half)finalAlpha, style.weight, style.slot);
        }
        else
        {
            float dist = _OdsEnabled != 0 ? odsDist : centerClipPos.w;
            finalAlpha *= DofBlurAxes(view.axis1, view.axis2, DofBlurRadius(dist, DofFocalPx(_MatrixP)));
            col.a = (half)finalAlpha;
            view.color = PackViewColor(col);
        }
    }

    return view;
}

// Chunk frustum culling: 4 chunks per group (GROUP_SIZE=1024 / kChunkSize=256)
groupshared uint _chunkVisible[4];

// True when all 8 corners of the object-space AABB lie outside one clip plane.
bool ChunkOutsideFrustum(float4x4 mvp, float3 bmin, float3 bmax)
{
    // Clip-space near limit: z in [0,w] for reversed-Z / D3D-style
    // projections, [-w,w] for OpenGL.
    #if UNITY_REVERSED_Z
    #define NEAR_LIMIT(p) 0
    #else
    #define NEAR_LIMIT(p) (-(p).w)
    #endif
    bool outL = true, outR = true, outB = true, outT = true, outN = true, outF = true;
    [unroll]
    for (uint c = 0; c < 8; c++)
    {
        float3 corner = float3((c & 1) ? bmax.x : bmin.x,
                               (c & 2) ? bmax.y : bmin.y,
                               (c & 4) ? bmax.z : bmin.z);
        float4 p = mul(mvp, float4(corner, 1));
        if (p.x >= -p.w) outL = false;
        if (p.x <=  p.w) outR = false;
        if (p.y >= -p.w) outB = false;
        if (p.y <=  p.w) outT = false;
        if (p.z >= NEAR_LIMIT(p)) outN = false;
        if (p.z <=  p.w) outF = false;
    }
    #undef NEAR_LIMIT
    return outL || outR || outB || outT || outN || outF;
}

void ChunkBounds(uint chunkIdx, out float3 bmin, out float3 bmax)
{
    if (_DynamicChunkBoundsValid != 0)
    {
        bmin = _DynamicChunkBounds[chunkIdx * 2].xyz;
        bmax = _DynamicChunkBounds[chunkIdx * 2 + 1].xyz;
        return;
    }
    SplatChunkInfo chunk = _SplatChunks[chunkIdx];
    bmin = float3(chunk.posX.x, chunk.posY.x, chunk.posZ.x);
    bmax = float3(chunk.posX.y, chunk.posY.y, chunk.posZ.y);
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID)
{
    uint idx = id.x;
    uint localIdx = gtid.x;
    uint chunkSlot = localIdx / kChunkSize;    // 0..3
    uint laneInChunk = localIdx % kChunkSize;

    // Phase 1: chunk frustum culling (first thread per 256-splat chunk)
    // Skip when morph is active (morphed positions leave the chunk AABB);
    // moving chunks (animation, mesh driver) are tested against their
    // current bounds instead.
    // Chunk culling tests AABB corners against the _MatrixVP frustum, which
    // does not exist under ODS — and nothing is off-screen there anyway.
    bool canCull = (_SplatChunkCount > 0) && (_MorphDataValid == 0) && (_OdsEnabled == 0);

    if (laneInChunk == 0)
    {
        _chunkVisible[chunkSlot] = 1; // default visible
        if (canCull)
        {
            uint globalChunkIdx = idx / kChunkSize;
            if (globalChunkIdx < _SplatChunkCount)
            {
                float3 bmin, bmax;
                ChunkBounds(globalChunkIdx, bmin, bmax);
                bmin -= _StyleChunkExpand;
                bmax += _StyleChunkExpand;
                if (ChunkOutsideFrustum(mul(_MatrixVP, _MatrixObjectToWorld), bmin, bmax))
                    _chunkVisible[chunkSlot] = 0;
            }
        }
    }

    // ALL threads must hit the barrier (no early return before this)
    GroupMemoryBarrierWithGroupSync();

    if (idx >= _SplatCount)
        return;

    // Culled chunk -> write invisible marker and skip
    if (_chunkVisible[chunkSlot] == 0)
    {
        SplatViewData view = (SplatViewData)0;
        if (_IsStereo) { _SplatViewData[idx * 2 + _StereoEyeIndex] = view; }
        else { _SplatViewData[idx] = view; }
        return;
    }

    SplatData splat;
    if (_MorphDataValid != 0)
    {
        uint mb = idx * 4;
        float4 md0 = _MorphedData[mb + 0];
        float4 md1 = _MorphedData[mb + 1];
        float4 md2 = _MorphedData[mb + 2];
        float4 md3 = _MorphedData[mb + 3];

        splat = (SplatData)0;

        // Load blended SH from morph SH buffer when available (MorphDataValid == 2)
        if (_MorphDataValid >= 2)
        {
            uint shBase = idx * 15;
            splat.sh.sh1  = (half3)_MorphSHData[shBase + 0].xyz;
            splat.sh.sh2  = (half3)_MorphSHData[shBase + 1].xyz;
            splat.sh.sh3  = (half3)_MorphSHData[shBase + 2].xyz;
            splat.sh.sh4  = (half3)_MorphSHData[shBase + 3].xyz;
            splat.sh.sh5  = (half3)_MorphSHData[shBase + 4].xyz;
            splat.sh.sh6  = (half3)_MorphSHData[shBase + 5].xyz;
            splat.sh.sh7  = (half3)_MorphSHData[shBase + 6].xyz;
            splat.sh.sh8  = (half3)_MorphSHData[shBase + 7].xyz;
            splat.sh.sh9  = (half3)_MorphSHData[shBase + 8].xyz;
            splat.sh.sh10 = (half3)_MorphSHData[shBase + 9].xyz;
            splat.sh.sh11 = (half3)_MorphSHData[shBase + 10].xyz;
            splat.sh.sh12 = (half3)_MorphSHData[shBase + 11].xyz;
            splat.sh.sh13 = (half3)_MorphSHData[shBase + 12].xyz;
            splat.sh.sh14 = (half3)_MorphSHData[shBase + 13].xyz;
            splat.sh.sh15 = (half3)_MorphSHData[shBase + 14].xyz;
        }
        else if (idx < _SrcSplatCount && _SHOrder > 0)
        {
            // Fallback: load source SH and fade by (1 - weight)
            SplatData srcSplat = LoadSplatData(idx, _SHOrder);
            half shFade = (half)(1.0 - _MorphWeight);
            splat.sh.sh1  = srcSplat.sh.sh1  * shFade; splat.sh.sh2  = srcSplat.sh.sh2  * shFade;
            splat.sh.sh3  = srcSplat.sh.sh3  * shFade; splat.sh.sh4  = srcSplat.sh.sh4  * shFade;
            splat.sh.sh5  = srcSplat.sh.sh5  * shFade; splat.sh.sh6  = srcSplat.sh.sh6  * shFade;
            splat.sh.sh7  = srcSplat.sh.sh7  * shFade; splat.sh.sh8  = srcSplat.sh.sh8  * shFade;
            splat.sh.sh9  = srcSplat.sh.sh9  * shFade; splat.sh.sh10 = srcSplat.sh.sh10 * shFade;
            splat.sh.sh11 = srcSplat.sh.sh11 * shFade; splat.sh.sh12 = srcSplat.sh.sh12 * shFade;
            splat.sh.sh13 = srcSplat.sh.sh13 * shFade; splat.sh.sh14 = srcSplat.sh.sh14 * shFade;
            splat.sh.sh15 = srcSplat.sh.sh15 * shFade;
        }

        // Override base properties with morphed data
        splat.pos     = md0.xyz;
        splat.rot     = md1;
        splat.scale   = md2.xyz;
        splat.opacity = (half)md0.w;
        splat.sh.col  = (half3)md3.rgb;
    }
    else
    {
        splat = LoadBaseSplat(idx, _SHOrder);
    }

    // Apply animation position offset if available
    float animOpacityMul = 1.0;
    float animScaleMul = 1.0;
    float3 animColorTint = float3(1, 1, 1);
    float animColorBlend = 0;
    if (HasAnimData(idx))
    {
        uint animBase = idx * 3;
        float4 animPosOp = _AnimOutputData[animBase + 0]; // posOffset.xyz, opacityMul
        float4 animScaleColor = _AnimOutputData[animBase + 1]; // scaleMul, colorBlend, 0, 0
        float4 animTint = _AnimOutputData[animBase + 2]; // colorTint.rgb, 1

        splat.pos += animPosOp.xyz;
        animOpacityMul = animPosOp.w;
        animScaleMul = animScaleColor.x;
        animColorBlend = animScaleColor.y;
        animColorTint = animTint.xyz;
    }

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos,1)).xyz;
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    // Determine deleted state (guard against OOB for target-only extra splats during morph)
    bool isDeleted = false;
    if (_SplatBitsValid && idx < _SrcSplatCount)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        isDeleted = (wordVal & (1 << bitIdx)) != 0;
    }

    // Cutout check (uses object-space position)
    bool isCut = IsSplatCut(splat.pos);
    StyleSample style = StyleAt(centerWorldPos);
    ApplyStyleQuantize(idx, style, splat, centerWorldPos);

    // Selection highlight: apply to the final view data after helper returns
    // (only relevant for non-stereo / editor usage, but keep consistent)
    bool isSelected = false;
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint selVal = _SplatSelectedBits.Load(wordIdx * 4);
        isSelected = (selVal & (1 << bitIdx)) != 0;
    }

    // Use explicit _MatrixVP (not UNITY_MATRIX_VP) for clip position.
    // SetViewProjectionMatrices does NOT update UNITY_MATRIX_VP for
    // compute dispatches on Metal/visionOS — confirmed via diagnostics.
    SplatViewData view = CalculateEyeViewData(idx, splat, centerWorldPos,
        _MatrixVP, isDeleted, isCut, splatScale, opacityScale,
        animOpacityMul, animScaleMul, animColorBlend, animColorTint, style);
    if (_QuadBakeDeferred == 0)
        BakeQuad(view, centerWorldPos, _MatrixVP, DofFocalPx(_MatrixP));

    // Apply selection highlight (negate alpha to signal selected state)
    if (isSelected)
    {
        half alpha = ViewAlpha(view.color);
        if (alpha > 0)
            SetViewAlpha(view.color, -max(alpha, 1.0 / 255.0));
    }

    if (_IsStereo)
        _SplatViewData[idx * 2 + _StereoEyeIndex] = view;
    else
        _SplatViewData[idx] = view;
}

// Single-dispatch stereo kernel: computes view-independent data ONCE (3D covariance,
// SH shading, splat loading) then per-eye data TWICE (clip pos, 2D covariance).
// Saves ~40% compute vs dispatching CSCalcViewData twice.
[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewDataStereo (uint3 id : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID)
{
    uint idx = id.x;
    uint localIdx = gtid.x;
    uint chunkSlot = localIdx / kChunkSize;
    uint laneInChunk = localIdx % kChunkSize;

    // Chunk frustum culling: a chunk is skipped only when it is outside BOTH
    // eye frusta — the right eye sees past the left eye's right edge.
    // Chunk culling tests AABB corners against the _MatrixVP frustum, which
    // does not exist under ODS — and nothing is off-screen there anyway.
    bool canCull = (_SplatChunkCount > 0) && (_MorphDataValid == 0) && (_OdsEnabled == 0);
    if (laneInChunk == 0)
    {
        _chunkVisible[chunkSlot] = 1;
        if (canCull)
        {
            uint globalChunkIdx = idx / kChunkSize;
            if (globalChunkIdx < _SplatChunkCount)
            {
                float3 bmin, bmax;
                ChunkBounds(globalChunkIdx, bmin, bmax);
                bmin -= _StyleChunkExpand;
                bmax += _StyleChunkExpand;
                if (ChunkOutsideFrustum(mul(_MatrixVP_Eye[0], _MatrixObjectToWorld), bmin, bmax) &&
                    ChunkOutsideFrustum(mul(_MatrixVP_Eye[1], _MatrixObjectToWorld), bmin, bmax))
                    _chunkVisible[chunkSlot] = 0;
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    if (idx >= _SplatCount)
        return;

    if (_chunkVisible[chunkSlot] == 0)
    {
        _SplatViewData[idx * 2 + 0] = (SplatViewData)0;
        _SplatViewData[idx * 2 + 1] = (SplatViewData)0;
        return;
    }

    // Load splat data ONCE — same logic as CSCalcViewData
    SplatData splat;
    if (_MorphDataValid != 0)
    {
        uint mb = idx * 4;
        float4 md0 = _MorphedData[mb + 0];
        float4 md1 = _MorphedData[mb + 1];
        float4 md2 = _MorphedData[mb + 2];
        float4 md3 = _MorphedData[mb + 3];
        splat = (SplatData)0;
        if (_MorphDataValid >= 2)
        {
            uint shBase = idx * 15;
            splat.sh.sh1  = (half3)_MorphSHData[shBase + 0].xyz;
            splat.sh.sh2  = (half3)_MorphSHData[shBase + 1].xyz;
            splat.sh.sh3  = (half3)_MorphSHData[shBase + 2].xyz;
            splat.sh.sh4  = (half3)_MorphSHData[shBase + 3].xyz;
            splat.sh.sh5  = (half3)_MorphSHData[shBase + 4].xyz;
            splat.sh.sh6  = (half3)_MorphSHData[shBase + 5].xyz;
            splat.sh.sh7  = (half3)_MorphSHData[shBase + 6].xyz;
            splat.sh.sh8  = (half3)_MorphSHData[shBase + 7].xyz;
            splat.sh.sh9  = (half3)_MorphSHData[shBase + 8].xyz;
            splat.sh.sh10 = (half3)_MorphSHData[shBase + 9].xyz;
            splat.sh.sh11 = (half3)_MorphSHData[shBase + 10].xyz;
            splat.sh.sh12 = (half3)_MorphSHData[shBase + 11].xyz;
            splat.sh.sh13 = (half3)_MorphSHData[shBase + 12].xyz;
            splat.sh.sh14 = (half3)_MorphSHData[shBase + 13].xyz;
            splat.sh.sh15 = (half3)_MorphSHData[shBase + 14].xyz;
        }
        else if (idx < _SrcSplatCount && _SHOrder > 0)
        {
            SplatData srcSplat = LoadSplatData(idx, _SHOrder);
            half shFade = (half)(1.0 - _MorphWeight);
            splat.sh.sh1  = srcSplat.sh.sh1  * shFade; splat.sh.sh2  = srcSplat.sh.sh2  * shFade;
            splat.sh.sh3  = srcSplat.sh.sh3  * shFade; splat.sh.sh4  = srcSplat.sh.sh4  * shFade;
            splat.sh.sh5  = srcSplat.sh.sh5  * shFade; splat.sh.sh6  = srcSplat.sh.sh6  * shFade;
            splat.sh.sh7  = srcSplat.sh.sh7  * shFade; splat.sh.sh8  = srcSplat.sh.sh8  * shFade;
            splat.sh.sh9  = srcSplat.sh.sh9  * shFade; splat.sh.sh10 = srcSplat.sh.sh10 * shFade;
            splat.sh.sh11 = srcSplat.sh.sh11 * shFade; splat.sh.sh12 = srcSplat.sh.sh12 * shFade;
            splat.sh.sh13 = srcSplat.sh.sh13 * shFade; splat.sh.sh14 = srcSplat.sh.sh14 * shFade;
            splat.sh.sh15 = srcSplat.sh.sh15 * shFade;
        }
        splat.pos     = md0.xyz;
        splat.rot     = md1;
        splat.scale   = md2.xyz;
        splat.opacity = (half)md0.w;
        splat.sh.col  = (half3)md3.rgb;
    }
    else
    {
        splat = LoadBaseSplat(idx, _SHOrder);
    }

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos, 1)).xyz;

    // Animation
    float animOpacityMul = 1.0;
    float animScaleMul = 1.0;
    float3 animColorTint = float3(1, 1, 1);
    float animColorBlend = 0;
    if (HasAnimData(idx))
    {
        uint animBase = idx * 3;
        float4 animPosOp = _AnimOutputData[animBase + 0];
        float4 animScaleColor = _AnimOutputData[animBase + 1];
        float4 animTint = _AnimOutputData[animBase + 2];
        splat.pos += animPosOp.xyz;
        centerWorldPos += mul((float3x3)_MatrixObjectToWorld, animPosOp.xyz);
        animScaleMul   = animScaleColor.x;
        animOpacityMul = animPosOp.w;
        animColorBlend = animScaleColor.y;
        animColorTint  = animTint.xyz;
    }

    // Deleted/selected state
    bool isDeleted = false;
    if (_SplatBitsValid && idx < _SrcSplatCount)
    {
        uint wordVal = _SplatDeletedBits.Load((idx / 32) * 4);
        isDeleted = (wordVal & (1 << (idx & 31))) != 0;
    }
    bool isCut = IsSplatCut(splat.pos);
    StyleSample style = StyleAt(centerWorldPos);
    ApplyStyleQuantize(idx, style, splat, centerWorldPos);
    bool isSelected = false;
    if (_SplatBitsValid)
    {
        uint selVal = _SplatSelectedBits.Load((idx / 32) * 4);
        isSelected = (selVal & (1 << (idx & 31))) != 0;
    }

    // Compute view-independent data ONCE
    SplatSharedData ssd = CalcSharedSplatData(
        idx, splat, centerWorldPos, isDeleted, isCut,
        _SplatScale, _SplatOpacityScale,
        animOpacityMul, animScaleMul, animColorBlend, animColorTint, style);

    // Compute per-eye data (lightweight)
    [unroll]
    for (uint eye = 0; eye < 2; eye++)
    {
        SplatViewData view = CalcPerEyeViewData(
            splat, ssd,
            _MatrixVP_Eye[eye], _MatrixP_Eye[eye], _MatrixMV_Eye[eye],
            _SplatScale);
        if (_QuadBakeDeferred == 0)
            BakeQuad(view, ssd.worldPos, _MatrixVP_Eye[eye], DofFocalPx(_MatrixP_Eye[eye]));

        if (isSelected && view.pos.w > 0)
        {
            half alpha = ViewAlpha(view.color);
            if (alpha > 0)
                SetViewAlpha(view.color, -max(alpha, 1.0 / 255.0));
        }

        _SplatViewData[idx * 2 + eye] = view;
    }
}

[numthreads(GROUP_SIZE,1,1)]
void CSCopyViewDataAndDistances(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _CopyKernelCount)
        return;

    uint srcIdx = _CopySrcStartIndex + idx;
    uint dstIdx = _CopyDstStartIndex + idx;
    if (srcIdx >= _SplatCount)
        return;

    SplatViewData view = _SplatViewData[srcIdx];
    _CopyDstViewData[dstIdx] = view;

    // Global path is mono-only (stereo devices use the per-object path).
    if (_SortAllVisible == 0 && !IsSplatViewVisible(view))
    {
        _CopyDstSortDistances[dstIdx] = 0xFFFFFFFF;
    }
    else
    {
        float3 pos = mul(_MatrixMV, float4(LoadSortPos(srcIdx), 1)).xyz;
        _CopyDstSortDistances[dstIdx] = DepthToSortKey(SortDepth(pos));
        if (_CopyWriteKeys != 0)
            InterlockedAdd(_VisibleCounter[0], 1);
    }
    if (_CopyWriteKeys != 0)
        _CopyDstSortKeys[dstIdx] = dstIdx;
}

// Writes DrawProceduralIndirect args: draw only the visible front portion
// of the sorted order (invisible splats hold sentinel keys at the tail).
[numthreads(1,1,1)]
void CSWriteIndirectArgs (uint3 id : SV_DispatchThreadID)
{
    _IndirectArgs[0] = _IndirectIndexCount;  // indices per instance
    _IndirectArgs[1] = _VisibleCounter[0];   // instance count = visible splats
    _IndirectArgs[2] = 0;                    // start index
    _IndirectArgs[3] = 0;                    // base vertex
    _IndirectArgs[4] = 0;                    // start instance
}

// Occlusion culling: drops splats hidden behind a nearer surface of the same
// model. Every visible splat that blocks light writes its view depth over its
// footprint into a coarse screen grid that keeps the nearest; a second pass
// culls splats lying more than _OcclusionTolerance behind the nearest depth
// of their cell. It works on the view data, so every draw path, stereo and
// ODS inherit it.
RWByteAddressBuffer _OcclusionGrid;
uint2 _OcclusionGridSize;       // cells per eye
float _OcclusionCellSize;       // pixels per cell
float _OcclusionFootprintScale; // widens footprints to close the gaps between samples
float _OcclusionTolerance;      // depth behind the nearest surface still kept
// Bounds the per-splat write cost for footprints that fill the screen
#define OCCLUSION_MAX_RADIUS 4

uint OcclusionEyeCount() { return _IsStereo != 0 ? 2 : 1; }
uint OcclusionViewIndex(uint idx, uint eye) { return _IsStereo != 0 ? idx * 2 + eye : idx; }

bool OcclusionCell(SplatViewData view, out int2 cell)
{
    // Clip w is view depth in perspective and eye distance under ODS; both
    // divide back to NDC the same way
    float2 ndc = view.pos.xy / view.pos.w;
    cell = int2(floor((ndc * 0.5 + 0.5) * _VecScreenParams.xy / _OcclusionCellSize));
    return all(cell >= 0) && all(cell < (int2)_OcclusionGridSize);
}

uint OcclusionAddress(int2 cell, uint eye)
{
    return ((eye * _OcclusionGridSize.y + cell.y) * _OcclusionGridSize.x + cell.x) * 4;
}

// Opacity with which a splat hides what is behind it, as it will be drawn:
// with the point boost and clamp BakeQuad applies after this pass, less the
// share the style turns into added light. A fully additive splat hides
// nothing, so it must not occlude, however bright it is.
float OcclusionBlockedOpacity(SplatViewData view)
{
    float opacity = abs(ViewAlpha(view.color));
    if (_BakeQuads == 0)
        return opacity;
    if (_QuadBaseShape == 1)
        opacity = saturate(opacity * _PointOpacityBoost);
    return opacity * (1.0 - _StyleSizeParams[BakedViewStyleSlot(view.color)].z * BakedViewStyleWeight(view.color));
}

[numthreads(GROUP_SIZE,1,1)]
void CSOcclusionClear (uint3 id : SV_DispatchThreadID)
{
    if (id.x < _OcclusionGridSize.x * _OcclusionGridSize.y * OcclusionEyeCount())
        _OcclusionGrid.Store(id.x * 4, 0xFFFFFFFF);
}

[numthreads(GROUP_SIZE,1,1)]
void CSOcclusionSplat (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    for (uint eye = 0; eye < OcclusionEyeCount(); eye++)
    {
        SplatViewData view = _SplatViewData[OcclusionViewIndex(idx, eye)];
        int2 cell;
        if (!IsSplatViewVisible(view) || !OcclusionCell(view, cell))
            continue;
        // Only what blocks light forms a surface; the splat itself may
        // still be hidden behind one in the cull pass
        if (OcclusionBlockedOpacity(view) < SPLAT_CULL_ALPHA)
            continue;

        // Positive floats order the same as their bit patterns
        uint depth = asuint(view.pos.w);
        float footprintPx = sqrt(length(view.axis1) * length(view.axis2)) * _OcclusionFootprintScale;
        int radius = min((int)(footprintPx / _OcclusionCellSize + 0.5), OCCLUSION_MAX_RADIUS);
        for (int y = -radius; y <= radius; y++)
        {
            for (int x = -radius; x <= radius; x++)
            {
                int2 c = cell + int2(x, y);
                if (x * x + y * y > radius * radius || any(c < 0) || any(c >= (int2)_OcclusionGridSize))
                    continue;
                _OcclusionGrid.InterlockedMin(OcclusionAddress(c, eye), depth);
            }
        }
    }
}

[numthreads(GROUP_SIZE,1,1)]
void CSOcclusionCull (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    for (uint eye = 0; eye < OcclusionEyeCount(); eye++)
    {
        uint viewIdx = OcclusionViewIndex(idx, eye);
        SplatViewData view = _SplatViewData[viewIdx];
        int2 cell;
        if (!IsSplatViewVisible(view) || !OcclusionCell(view, cell))
            continue;

        float nearest = asfloat(_OcclusionGrid.Load(OcclusionAddress(cell, eye)));
        if (view.pos.w > nearest + _OcclusionTolerance)
        {
            // Same marker as the frustum cull: the draw discards it and the
            // sort leaves it out
            view.pos.w = 0;
            _SplatViewData[viewIdx] = view;
        }
    }
}

// Deferred quads (_QuadBakeDeferred): bakes them into view data a pass after
// the view-data kernels has finished with. Reads nothing but the view data;
// the splat's world position comes back from its clip position.
[numthreads(GROUP_SIZE,1,1)]
void CSBakeQuads (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint eyeCount = _IsStereo != 0 ? 2 : 1;
    for (uint eye = 0; eye < eyeCount; eye++)
    {
        uint viewIdx = _IsStereo != 0 ? idx * 2 + eye : idx;
        SplatViewData view = _SplatViewData[viewIdx];
        if (view.pos.w <= 0)
            continue;
        float4x4 vp = _IsStereo != 0 ? _MatrixVP_Eye[eye] : _MatrixVP;
        float4x4 p = _IsStereo != 0 ? _MatrixP_Eye[eye] : _MatrixP;
        float3 worldPos;
        if (_OdsEnabled != 0)
        {
            worldPos = OdsUnproject(view.pos);
        }
        else
        {
            float4 world = mul(_IsStereo != 0 ? _MatrixInvVP_Eye[eye] : _MatrixInvVP, view.pos);
            worldPos = world.xyz / world.w;
        }
        BakeQuad(view, worldPos, vp, DofFocalPx(p));
        _SplatViewData[viewIdx] = view;
    }
}


RWByteAddressBuffer _DstBuffer;
ByteAddressBuffer _SrcBuffer;
uint _BufferSize;

uint2 GetSplatIndicesFromWord(uint idx)
{
    uint idxStart = idx * 32;
    uint idxEnd = min(idxStart + 32, _SplatCount);
    return uint2(idxStart, idxEnd);
}

[numthreads(GROUP_SIZE,1,1)]
void CSUpdateEditData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;

    uint valSel = _SplatSelectedBits.Load(idx * 4);
    uint valDel = _SplatDeletedBits.Load(idx * 4);
    valSel &= ~valDel; // don't count deleted splats as selected
    uint2 splatIndices = GetSplatIndicesFromWord(idx);

    // update selection bounds
    float3 bmin = 1.0e38;
    float3 bmax = -1.0e38;
    uint mask = 1;
    uint valCut = 0;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        // don't count cut splats as selected
        if (IsSplatCut(spos))
        {
            valSel &= ~mask;
            valCut |= mask;
        }
        if (valSel & mask)
        {
            bmin = min(bmin, spos);
            bmax = max(bmax, spos);
        }
    }
    valCut &= ~valDel; // don't count deleted splats as cut

    if (valSel != 0)
    {
        _DstBuffer.InterlockedMin(12, FloatToSortableUint(bmin.x));
        _DstBuffer.InterlockedMin(16, FloatToSortableUint(bmin.y));
        _DstBuffer.InterlockedMin(20, FloatToSortableUint(bmin.z));
        _DstBuffer.InterlockedMax(24, FloatToSortableUint(bmax.x));
        _DstBuffer.InterlockedMax(28, FloatToSortableUint(bmax.y));
        _DstBuffer.InterlockedMax(32, FloatToSortableUint(bmax.z));
    }
    uint sumSel = countbits(valSel);
    uint sumDel = countbits(valDel);
    uint sumCut = countbits(valCut);
    _DstBuffer.InterlockedAdd(0, sumSel);
    _DstBuffer.InterlockedAdd(4, sumDel);
    _DstBuffer.InterlockedAdd(8, sumCut);
}

[numthreads(1,1,1)]
void CSInitEditData (uint3 id : SV_DispatchThreadID)
{
    _DstBuffer.Store3(0, uint3(0,0,0)); // selected, deleted, cut counts
    uint initMin = FloatToSortableUint(1.0e38);
    uint initMax = FloatToSortableUint(-1.0e38);
    _DstBuffer.Store3(12, uint3(initMin, initMin, initMin));
    _DstBuffer.Store3(24, uint3(initMax, initMax, initMax));
}

[numthreads(GROUP_SIZE,1,1)]
void CSClearBuffer (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    _DstBuffer.Store(idx * 4, 0);
}

[numthreads(GROUP_SIZE,1,1)]
void CSInvertSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = _DstBuffer.Load(idx * 4);
    v = ~v;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}

[numthreads(GROUP_SIZE,1,1)]
void CSSelectAll (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = ~0;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}


[numthreads(GROUP_SIZE,1,1)]
void CSOrBuffers (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint a = _SrcBuffer.Load(idx * 4);
    uint b = _DstBuffer.Load(idx * 4);
    _DstBuffer.Store(idx * 4, a | b);
}

float4 _SelectionRect;

[numthreads(GROUP_SIZE,1,1)]
void CSSelectionUpdate (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    centerClipPos.y *= -1;
    bool behindCam = centerClipPos.w <= 0;
    if (behindCam)
        return;

    float2 pixelPos = (centerClipPos.xy / centerClipPos.w * float2(0.5, -0.5) + 0.5) * _VecScreenParams.xy;
    if (pixelPos.x < _SelectionRect.x || pixelPos.x > _SelectionRect.z ||
        pixelPos.y < _SelectionRect.y || pixelPos.y > _SelectionRect.w)
    {
        return;
    }
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx); // +
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx)); // -
}

float3 _SelectionDelta;

bool IsSplatSelected(uint idx)
{
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    uint selVal = _SplatSelectedBits.Load(wordIdx * 4);
    return (selVal & (1 << bitIdx)) != 0;
}

[numthreads(GROUP_SIZE,1,1)]
void CSTranslateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = SplatFormatPos(_SplatFormat);
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPos.Load3(idx * stride));
        pos += _SelectionDelta;
        _SplatPos.Store3(idx * stride, asuint(pos));
    }
}

float3 _SelectionCenter;
float4 _SelectionDeltaRot;
ByteAddressBuffer _SplatPosMouseDown;
ByteAddressBuffer _SplatOtherMouseDown;

[numthreads(GROUP_SIZE,1,1)]
void CSRotateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint posFmt = SplatFormatPos(_SplatFormat);
    if (_SplatChunkCount == 0 && posFmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * posStride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos = QuatRotateVector(pos, _SelectionDeltaRot);
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * posStride, asuint(pos));
    }

    uint scaleFmt = SplatFormatScale(_SplatFormat);
    uint shFormat = SplatFormatSH(_SplatFormat);
    if (_SplatChunkCount == 0 && scaleFmt == VECTOR_FMT_32F && shFormat == SPLAT_SH_FMT_32F)
    {
        uint otherStride = 4 + 12;
        uint rotVal = _SplatOtherMouseDown.Load(idx * otherStride);
        float4 rot = DecodeRotation(DecodePacked_10_10_10_2(rotVal));

        //@TODO: correct rotation
        rot = QuatMul(rot, _SelectionDeltaRot);

        rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(rot));
        _SplatOther.Store(idx * otherStride, rotVal);
    }

    //@TODO: rotate SHs
}

//@TODO: maybe scale the splat scale itself too?
[numthreads(GROUP_SIZE,1,1)]
void CSScaleSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = SplatFormatPos(_SplatFormat);
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * stride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos *= _SelectionDelta;
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * stride, asuint(pos));
    }
}

struct ExportSplatData
{
    float3 pos;
    float3 nor;
    float3 dc0;
    float4 shR14; float4 shR58; float4 shR9C; float3 shRDF;
    float4 shG14; float4 shG58; float4 shG9C; float3 shGDF;
    float4 shB14; float4 shB58; float4 shB9C; float3 shBDF;
    float opacity;
    float3 scale;
    float4 rot;
};
RWStructuredBuffer<ExportSplatData> _ExportBuffer;

float3 ColorToSH0(float3 col)
{
    return (col - 0.5) / 0.2820948;
}
float InvSigmoid(float v)
{
    return log(v / max(1 - v, 1.0e-6));
}

// SH rotation
#include "../Shaders/SphericalHarmonics.hlsl"

void RotateSH(inout SplatSHData sh, float3x3 rot)
{
    float3 shin[16];
    float3 shout[16];
    shin[0] = sh.col;
    shin[1] = sh.sh1;
    shin[2] = sh.sh2;
    shin[3] = sh.sh3;
    shin[4] = sh.sh4;
    shin[5] = sh.sh5;
    shin[6] = sh.sh6;
    shin[7] = sh.sh7;
    shin[8] = sh.sh8;
    shin[9] = sh.sh9;
    shin[10] = sh.sh10;
    shin[11] = sh.sh11;
    shin[12] = sh.sh12;
    shin[13] = sh.sh13;
    shin[14] = sh.sh14;
    shin[15] = sh.sh15;
    RotateSH(rot, 4, shin, shout);
    sh.col = shout[0];
    sh.sh1 = shout[1];
    sh.sh2 = shout[2];
    sh.sh3 = shout[3];
    sh.sh4 = shout[4];
    sh.sh5 = shout[5];
    sh.sh6 = shout[6];
    sh.sh7 = shout[7];
    sh.sh8 = shout[8];
    sh.sh9 = shout[9];
    sh.sh10 = shout[10];
    sh.sh11 = shout[11];
    sh.sh12 = shout[12];
    sh.sh13 = shout[13];
    sh.sh14 = shout[14];
    sh.sh15 = shout[15];
}

float3x3 CalcSHRotMatrix(float4x4 objToWorld)
{
    float3x3 m = (float3x3)objToWorld;
    float sx = length(float3(m[0][0], m[0][1], m[0][2]));
    float sy = length(float3(m[1][0], m[1][1], m[1][2]));
    float sz = length(float3(m[2][0], m[2][1], m[2][2]));

    float invSX = 1.0 / sx;
    float invSY = 1.0 / sy;
    float invSZ = 1.0 / sz;

    m[0][0] *= invSX;
    m[0][1] *= invSX;
    m[0][2] *= invSX;
    m[1][0] *= invSY;
    m[1][1] *= invSY;
    m[1][2] *= invSY;
    m[2][0] *= invSZ;
    m[2][1] *= invSZ;
    m[2][2] *= invSZ;
    return m;
}


float4 _ExportTransformRotation;
float3 _ExportTransformScale;
uint _ExportTransformFlags;

[numthreads(GROUP_SIZE,1,1)]
void CSExportData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    SplatData src = LoadSplatData(idx);

    bool isCut = IsSplatCut(src.pos);

    // transform splat by matrix, if needed
    if (_ExportTransformFlags != 0)
    {
        src.pos = mul(_MatrixObjectToWorld, float4(src.pos,1)).xyz;

        // note: this only handles axis flips from scale, not any arbitrary scaling
        if (_ExportTransformScale.x < 0)
            src.rot.yz = -src.rot.yz;
        if (_ExportTransformScale.y < 0)
            src.rot.xz = -src.rot.xz;
        if (_ExportTransformScale.z < 0)
            src.rot.xy = -src.rot.xy;
        src.rot = QuatMul(_ExportTransformRotation, src.rot);
        src.scale *= abs(_ExportTransformScale);

        float3x3 shRot = CalcSHRotMatrix(_MatrixObjectToWorld);
        RotateSH(src.sh, shRot);
    }

    ExportSplatData dst;
    dst.pos = src.pos;
    dst.nor = 0;
    dst.dc0 = ColorToSH0(src.sh.col);
    
    dst.shR14 = float4(src.sh.sh1.r, src.sh.sh2.r, src.sh.sh3.r, src.sh.sh4.r);
    dst.shR58 = float4(src.sh.sh5.r, src.sh.sh6.r, src.sh.sh7.r, src.sh.sh8.r);
    dst.shR9C = float4(src.sh.sh9.r, src.sh.sh10.r, src.sh.sh11.r, src.sh.sh12.r);
    dst.shRDF = float3(src.sh.sh13.r, src.sh.sh14.r, src.sh.sh15.r);
    
    dst.shG14 = float4(src.sh.sh1.g, src.sh.sh2.g, src.sh.sh3.g, src.sh.sh4.g);
    dst.shG58 = float4(src.sh.sh5.g, src.sh.sh6.g, src.sh.sh7.g, src.sh.sh8.g);
    dst.shG9C = float4(src.sh.sh9.g, src.sh.sh10.g, src.sh.sh11.g, src.sh.sh12.g);
    dst.shGDF = float3(src.sh.sh13.g, src.sh.sh14.g, src.sh.sh15.g);
    
    dst.shB14 = float4(src.sh.sh1.b, src.sh.sh2.b, src.sh.sh3.b, src.sh.sh4.b);
    dst.shB58 = float4(src.sh.sh5.b, src.sh.sh6.b, src.sh.sh7.b, src.sh.sh8.b);
    dst.shB9C = float4(src.sh.sh9.b, src.sh.sh10.b, src.sh.sh11.b, src.sh.sh12.b);
    dst.shBDF = float3(src.sh.sh13.b, src.sh.sh14.b, src.sh.sh15.b);
    
    dst.opacity = InvSigmoid(src.opacity);
    dst.scale = log(src.scale);
    dst.rot = src.rot.wxyz;

    if (isCut)
        dst.nor = 1; // mark as skipped for export
    
    _ExportBuffer[idx] = dst;
}

RWByteAddressBuffer _CopyDstPos;
RWByteAddressBuffer _CopyDstOther;
RWByteAddressBuffer _CopyDstSH;
RWByteAddressBuffer _CopyDstEditDeleted;
RWTexture2D<float4> _CopyDstColor;
uint _CopyDstSize, _CopyCount;
// The destination is all Float32 (VeryHigh); this is its SH degree
uint _CopyDstSHDegree;

float4x4 _CopyTransformMatrix;
float4 _CopyTransformRotation;
float3 _CopyTransformScale;

[numthreads(GROUP_SIZE,1,1)]
void CSCopySplats (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _CopyCount)
        return;
    uint srcIdx = _CopySrcStartIndex + idx;
    uint dstIdx = _CopyDstStartIndex + idx;
    if (srcIdx >= _SplatCount || dstIdx >= _CopyDstSize)
        return;

    SplatData src = LoadSplatData(srcIdx);

    // transform the splat
    src.pos = mul(_CopyTransformMatrix, float4(src.pos,1)).xyz;
    // note: this only handles axis flips from scale, not any arbitrary scaling
    if (_CopyTransformScale.x < 0)
        src.rot.yz = -src.rot.yz;
    if (_CopyTransformScale.y < 0)
        src.rot.xz = -src.rot.xz;
    if (_CopyTransformScale.z < 0)
        src.rot.xy = -src.rot.xy;
    src.rot = QuatMul(_CopyTransformRotation, src.rot);
    src.scale *= abs(_CopyTransformScale);

    float3x3 shRot = CalcSHRotMatrix(_CopyTransformMatrix);
    RotateSH(src.sh, shRot);

    // output data into destination:
    // pos
    uint posStride = 12;
    _CopyDstPos.Store3(dstIdx * posStride, asuint(src.pos));
    // rot + scale
    uint otherStride = 4 + 12;
    uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(src.rot));
    _CopyDstOther.Store4(dstIdx * otherStride, uint4(
        rotVal,
        asuint(src.scale.x),
        asuint(src.scale.y),
        asuint(src.scale.z)));
    // color
    uint3 pixelIndex = SplatIndexToPixelIndex(dstIdx);
    _CopyDstColor[pixelIndex.xy] = float4(src.sh.col, src.opacity);

    // SH: bands the destination does not store are dropped
    uint shCount = SplatSHCoeffCount(_CopyDstSHDegree);
    uint shOffset = dstIdx * SplatSHStride(SPLAT_SH_FMT_32F, _CopyDstSHDegree);
    if (shCount > 0)  _CopyDstSH.Store3(shOffset + 12 * 0, asuint(src.sh.sh1));
    if (shCount > 1)  _CopyDstSH.Store3(shOffset + 12 * 1, asuint(src.sh.sh2));
    if (shCount > 2)  _CopyDstSH.Store3(shOffset + 12 * 2, asuint(src.sh.sh3));
    if (shCount > 3)  _CopyDstSH.Store3(shOffset + 12 * 3, asuint(src.sh.sh4));
    if (shCount > 4)  _CopyDstSH.Store3(shOffset + 12 * 4, asuint(src.sh.sh5));
    if (shCount > 5)  _CopyDstSH.Store3(shOffset + 12 * 5, asuint(src.sh.sh6));
    if (shCount > 6)  _CopyDstSH.Store3(shOffset + 12 * 6, asuint(src.sh.sh7));
    if (shCount > 7)  _CopyDstSH.Store3(shOffset + 12 * 7, asuint(src.sh.sh8));
    if (shCount > 8)  _CopyDstSH.Store3(shOffset + 12 * 8, asuint(src.sh.sh9));
    if (shCount > 9)  _CopyDstSH.Store3(shOffset + 12 * 9, asuint(src.sh.sh10));
    if (shCount > 10) _CopyDstSH.Store3(shOffset + 12 * 10, asuint(src.sh.sh11));
    if (shCount > 11) _CopyDstSH.Store3(shOffset + 12 * 11, asuint(src.sh.sh12));
    if (shCount > 12) _CopyDstSH.Store3(shOffset + 12 * 12, asuint(src.sh.sh13));
    if (shCount > 13) _CopyDstSH.Store3(shOffset + 12 * 13, asuint(src.sh.sh14));
    if (shCount > 14) _CopyDstSH.Store3(shOffset + 12 * 14, asuint(src.sh.sh15));

    // deleted bits
    uint srcWordIdx = srcIdx / 32;
    uint srcBitIdx = srcIdx & 31;
    if (_SplatDeletedBits.Load(srcWordIdx * 4) & (1u << srcBitIdx))
    {
        uint dstWordIdx = dstIdx / 32;
        uint dstBitIdx = dstIdx & 31;
        _CopyDstEditDeleted.InterlockedOr(dstWordIdx * 4, 1u << dstBitIdx);
    }
}
