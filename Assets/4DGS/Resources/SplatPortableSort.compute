// SPDX-License-Identifier: MIT
// Portable stable LSD radix sort of (uint key, uint payload) pairs.
//
// Same contract as the DeviceRadixSort in SplatSort.compute — ascending,
// 8-bit digits from a start bit, an even pass count so the result lands back
// in the input buffers — but built only from groupshared memory and barriers:
// no wave intrinsics, no DXC. It is the sorter for GPUs where the wave-op
// kernels are unsupported (visionOS Metal), replacing a counting sort whose
// unordered scatter made equal-depth splats swap places every frame.
//
// Each pass:
//   CSUpsweep     per-tile digit histogram, stored tile-major
//   CSScanBlocks  per digit, exclusive scan of the tile counts within each
//                 block of BLOCK_TILES tiles, plus the block totals
//   CSScanDigits  single group: block totals to each block's global start
//                 per digit (digit-major order: digit, then block)
//   CSDownsweep   stable in-tile sort by the digit (4 two-bit splits), then
//                 scatter to block start + tile offset + rank in the tile
//
// Every histogram access is a contiguous RADIX-wide row (one tile or one
// block), so it coalesces; with a digit-major layout each tile would write,
// and the downsweep read, RADIX entries a whole column apart.
//
// Stability comes from the splits: each preserves the relative order of
// equal bit pairs, so equal digits keep their input order inside a tile, and
// tiles are laid out in order by the scans.

#pragma kernel CSUpsweep
#pragma kernel CSScanBlocks
#pragma kernel CSScanDigits
#pragma kernel CSDownsweep

#define THREADS 256
#define ITEMS 4
#define TILE (THREADS * ITEMS)
#define RADIX 256          // must equal THREADS: one histogram bin per thread
#define RADIX_BITS 8
#define SPLIT_BITS 2       // bits per in-tile split: 4 buckets, 16-bit counters
#define BLOCK_TILES 64     // tiles per scan block

uint _Count;               // keys to sort
uint _Shift;               // first key bit of this pass's digit
uint _TileCount;           // ceil(_Count / TILE)
uint _BlockCount;          // ceil(_TileCount / BLOCK_TILES)

StructuredBuffer<uint> _KeysIn;
StructuredBuffer<uint> _ValuesIn;
RWStructuredBuffer<uint> _KeysOut;
RWStructuredBuffer<uint> _ValuesOut;
RWStructuredBuffer<uint> _Histogram;   // [tile * RADIX + digit]: counts, then offsets within the block
RWStructuredBuffer<uint> _BlockSums;   // [block * RADIX + digit]: totals, then global starts

groupshared uint2 gs_scan[2 * THREADS];   // ping-pong halves
groupshared uint gs_hist[RADIX];
groupshared uint gs_keys[TILE];
groupshared uint gs_values[TILE];

// Exclusive scan of one value per thread across the group (Hillis-Steele).
// Each step reads one half of gs_scan and writes the other, so it needs a
// single barrier instead of a read barrier and a write barrier. Every thread
// of the group must call it.
uint2 GroupExclusiveScan2(uint2 value, uint thread, out uint2 total)
{
    uint src = 0;
    gs_scan[thread] = value;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint offset = 1; offset < THREADS; offset <<= 1)
    {
        uint2 sum = gs_scan[src + thread];
        if (thread >= offset)
            sum += gs_scan[src + thread - offset];
        src ^= THREADS;
        gs_scan[src + thread] = sum;
        GroupMemoryBarrierWithGroupSync();
    }
    uint2 inclusive = gs_scan[src + thread];
    total = gs_scan[src + THREADS - 1];
    // The next scan overwrites gs_scan; let every thread read its total first.
    GroupMemoryBarrierWithGroupSync();
    return inclusive - value;
}

uint GroupExclusiveScan(uint value, uint thread, out uint total)
{
    uint2 total2;
    uint exclusive = GroupExclusiveScan2(uint2(value, 0), thread, total2).x;
    total = total2.x;
    return exclusive;
}

// Four 16-bit bucket counters packed in a uint2 (bucket b in component b/2,
// half b%2). A tile holds at most TILE = 1024 keys, so no counter overflows.
uint2 BucketIncrement(uint bucket)
{
    uint add = 1u << ((bucket & 1) * 16);
    return (bucket & 2) != 0 ? uint2(0, add) : uint2(add, 0);
}

uint4 UnpackBuckets(uint2 packed)
{
    return uint4(packed.x & 0xFFFF, packed.x >> 16, packed.y & 0xFFFF, packed.y >> 16);
}

uint Digit(uint key)
{
    return (key >> _Shift) & (RADIX - 1);
}

[numthreads(THREADS, 1, 1)]
void CSUpsweep(uint thread : SV_GroupThreadID, uint tile : SV_GroupID)
{
    gs_hist[thread] = 0;
    GroupMemoryBarrierWithGroupSync();

    uint base = tile * TILE;
    [unroll]
    for (uint i = 0; i < ITEMS; i++)
    {
        uint idx = base + i * THREADS + thread;
        if (idx < _Count)
            InterlockedAdd(gs_hist[Digit(_KeysIn[idx])], 1);
    }
    GroupMemoryBarrierWithGroupSync();

    _Histogram[tile * RADIX + thread] = gs_hist[thread];
}

// One thread per digit walks the block's tiles in order; each step reads
// and writes one tile's contiguous row.
[numthreads(THREADS, 1, 1)]
void CSScanBlocks(uint digit : SV_GroupThreadID, uint block : SV_GroupID)
{
    uint first = block * BLOCK_TILES;
    uint last = min(first + BLOCK_TILES, _TileCount);
    uint running = 0;
    for (uint tile = first; tile < last; tile++)
    {
        uint idx = tile * RADIX + digit;
        uint count = _Histogram[idx];
        _Histogram[idx] = running;
        running += count;
    }
    _BlockSums[block * RADIX + digit] = running;
}

// Single group, one thread per digit: scans the block totals per digit, then
// offsets every digit by the keys of all lower digits.
[numthreads(THREADS, 1, 1)]
void CSScanDigits(uint digit : SV_GroupThreadID)
{
    uint running = 0;
    for (uint block = 0; block < _BlockCount; block++)
    {
        uint idx = block * RADIX + digit;
        uint count = _BlockSums[idx];
        _BlockSums[idx] = running;
        running += count;
    }
    uint unusedTotal;
    uint digitStart = GroupExclusiveScan(running, digit, unusedTotal);
    for (uint b = 0; b < _BlockCount; b++)
        _BlockSums[b * RADIX + digit] += digitStart;
}

[numthreads(THREADS, 1, 1)]
void CSDownsweep(uint thread : SV_GroupThreadID, uint tile : SV_GroupID)
{
    uint base = tile * TILE;
    uint validCount = min(TILE, _Count - base);

    // Blocked layout: thread t owns tile positions t*ITEMS .. t*ITEMS+ITEMS-1.
    // Padding keys are all-ones, so they rank after every real key of the
    // tile (the splits are stable and padding comes last in input order).
    uint keys[ITEMS];
    uint values[ITEMS];
    [unroll]
    for (uint i = 0; i < ITEMS; i++)
    {
        uint pos = thread * ITEMS + i;
        bool valid = pos < validCount;
        keys[i] = valid ? _KeysIn[base + pos] : 0xFFFFFFFFu;
        values[i] = valid ? _ValuesIn[base + pos] : 0;
    }

    // Stable in-tile sort by the digit: one split per bit pair, low bits
    // first. Each split counts the four buckets per thread, scans the counts
    // across the group and scatters every key to its bucket's next slot.
    [loop]
    for (uint bit = 0; bit < RADIX_BITS; bit += SPLIT_BITS)
    {
        uint shift = _Shift + bit;
        uint2 counts = 0;
        [unroll]
        for (uint c = 0; c < ITEMS; c++)
            counts += BucketIncrement((keys[c] >> shift) & 3);

        uint2 packedTotals;
        uint4 before = UnpackBuckets(GroupExclusiveScan2(counts, thread, packedTotals));
        uint4 totals = UnpackBuckets(packedTotals);
        // Buckets are laid out in order: each starts after all lower ones.
        uint4 next = before + uint4(0, totals.x, totals.x + totals.y, totals.x + totals.y + totals.z);

        [unroll]
        for (uint j = 0; j < ITEMS; j++)
        {
            uint bucket = (keys[j] >> shift) & 3;
            // Selects instead of next[bucket]: a dynamically indexed write
            // forces FXC to unroll the enclosing [loop].
            uint4 isBucket = uint4(0, 1, 2, 3) == bucket ? 1 : 0;
            uint dst = dot(next, isBucket);
            next += isBucket;
            gs_keys[dst] = keys[j];
            gs_values[dst] = values[j];
        }
        GroupMemoryBarrierWithGroupSync();

        [unroll]
        for (uint k = 0; k < ITEMS; k++)
        {
            uint pos = thread * ITEMS + k;
            keys[k] = gs_keys[pos];
            values[k] = gs_values[pos];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Where each digit starts inside the sorted tile (real keys only).
    gs_hist[thread] = 0;
    GroupMemoryBarrierWithGroupSync();
    [unroll]
    for (uint h = 0; h < ITEMS; h++)
    {
        if (thread * ITEMS + h < validCount)
            InterlockedAdd(gs_hist[Digit(keys[h])], 1);
    }
    GroupMemoryBarrierWithGroupSync();
    uint unusedTotal;
    uint digitStart = GroupExclusiveScan(gs_hist[thread], thread, unusedTotal);
    // gs_hist is reused to publish, per digit, where the tile's run of it
    // lands globally minus where it starts in the tile, so a key's
    // destination is that plus its tile position (wrapping uint math).
    gs_hist[thread] = _BlockSums[(tile / BLOCK_TILES) * RADIX + thread] +
                      _Histogram[tile * RADIX + thread] - digitStart;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint s = 0; s < ITEMS; s++)
    {
        uint pos = thread * ITEMS + s;
        if (pos < validCount)
        {
            uint dst = gs_hist[Digit(keys[s])] + pos;
            _KeysOut[dst] = keys[s];
            _ValuesOut[dst] = values[s];
        }
    }
}
