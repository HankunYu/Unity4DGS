// GPU radix sort kernels — separated from SplatUtilities.compute so that the
// wave-op requirements below only gate the sort. On GPUs without wave ops
// GpuSorters falls back to SplatPortableSort.compute.

// DeviceRadixSort
#pragma multi_compile __ KEY_UINT KEY_INT KEY_FLOAT
#pragma multi_compile __ PAYLOAD_UINT PAYLOAD_INT PAYLOAD_FLOAT
#pragma multi_compile __ SHOULD_ASCEND
#pragma multi_compile __ SORT_PAIRS
#pragma multi_compile __ VULKAN
#pragma kernel InitDeviceRadixSort
#pragma kernel Upsweep
#pragma kernel Scan
#pragma kernel Downsweep

// GPU sorting needs wave ops; wave intrinsics need DXC (FXC stops at SM 5.0).
// use_dxc adds no requirement of its own, only the two pragmas below do.
#pragma require wavebasic
#pragma require waveballot
#pragma use_dxc

#include "../Shaders/DeviceRadixSort.hlsl"
